# Run terraform/bootstrap first, then replace ACCOUNT_ID with: aws sts get-caller-identity --query Account --output text
# region = where the state bucket lives (must match bucket's region)
bucket         = "rdi-terraform-state-470900128247"
key            = "base-infra/staging/us-east-1/terraform.tfstate"
region         = "us-east-2"
dynamodb_table = "rdi-terraform-locks"
encrypt        = true
